# =============================================================================
# CinemaLibraryBot — environment template
# =============================================================================
# Copy this file to `data/.env` and fill in the values:
#     cp .env.example data/.env
#
# `data/` is the runtime directory (gitignored). It also holds the Pyrogram
# session file and the SQLite movie catalog (cine.db).
#
# See docs/configuration.md for a full description of every variable.
# Values shown after "=" are the DEFAULTS the app uses when the var is unset;
# variables marked "(required)" have NO default and must be provided.
# =============================================================================

# -----------------------------------------------------------------------------
# Telegram — core credentials
# -----------------------------------------------------------------------------
# Session name (the .session file is created as <DATA_DIR>/<NAME>.session)
NAME=cinemalibrarybot
# From https://my.telegram.org -> API development tools
TELEGRAM_API_ID=            # (required) e.g. 1234567
TELEGRAM_API_HASH=          # (required) e.g. 0123456789abcdef0123456789abcdef
# From @BotFather (/newbot). A bot token needs no phone login.
TELEGRAM_BOT_TOKEN=         # (required) e.g. 123456:ABC-DEF...

# -----------------------------------------------------------------------------
# Telegram — channels, groups & people (numeric IDs, usually negative for chats)
# -----------------------------------------------------------------------------
CINEMA_ID=                  # (required) main cinema channel ID
CHANNEL_ID=                 # (required) posts channel ID
GROUP_ID=                   # (required) community group ID (handles #cine orders)
ORDERS_ID=                  # (required) chat where movie requests are routed
PAY_GROUP=                  # (required) admin chat that receives payment screenshots
SENDER_BOT=                 # username/id of the delivery bot for file sending
OWNER_ID=                   # (required) your Telegram user ID (super-admin)
# Seconds before auto-delete of some throwaway messages
DELETE_MESSAGE_DELAY=30

# -----------------------------------------------------------------------------
# Databases
# -----------------------------------------------------------------------------
# Users DB (SQLAlchemy URL). In dev via docker-compose this points at Postgres.
USER_DB=postgresql+psycopg2://clbot:clbot@db:5432/clbot_users
# Posts DB (SQLAlchemy URL).
POSTGRE_DB_URL=postgresql+psycopg2://clbot:clbot@db:5432/clbot_posts
# The movie catalog (Game table) is SQLite and lives at <DATA_DIR>/cine.db.
# Override only if you must move it:
# CINE_DB_URL=sqlite:///./data/cine.db

# -----------------------------------------------------------------------------
# External APIs
# -----------------------------------------------------------------------------
# IMDb-style JSON API used by /info (search/titles + titles/{id}).
# Leave blank (or set MOCK_MOVIE_DATA=1) to serve fixtures offline for dev.
IMDB_API_URL=               # e.g. https://api.imdbapi.dev
# Groq API key (LLM translation of titles/synopses)
GROQ_KEY=
# OpenSubtitles (comma-separated API keys + account)
OPENSUBTITLES_KEYS=
OPENSUBTITLE_USERNAME=
OPENSUBTITLE_PASSWORD=

# -----------------------------------------------------------------------------
# Payments & pricing (VIP subscription) — plain text shown to users
# -----------------------------------------------------------------------------
VIP_PRICE_CUP=
VIP_PRICE_MLC=
VIP_PRICE_USD=
PRICE1=
PRICE2=
PRICE3=
# Cuban payment card numbers / contacts shown in the pay flow
CUP_CARD=
CUP_CARD2=
MLC_CARD=
MOBILE=
# Crypto wallet (BEP-20)
Wallet_BEP=
# QvaPay / PayPal "PayMe" link
QVAPAY_LINK=

# -----------------------------------------------------------------------------
# Streaming server (aiohttp) — all optional, defaults shown
# -----------------------------------------------------------------------------
STREAM_PORT=8080
STREAM_BIND=0.0.0.0
# Channel used as a temporary bin for files being streamed
STREAM_BIN_CHANNEL=         # (required for streaming) channel ID
# Public base URL. Leave blank to auto-start a Cloudflare tunnel in dev.
STREAM_URL=
STREAM_HASH_LENGTH=6
STREAM_MAX_CACHE_BYTES=209715200
STREAM_PREFETCH_COUNT=15
STREAM_SLEEP_THRESHOLD=30
STREAM_MAX_RETRIES=1
STREAM_RETRY_DELAY=0.5
STREAM_MAX_CONCURRENT_DOWNLOADS=8

# -----------------------------------------------------------------------------
# Local development / testing (not used in production)
# -----------------------------------------------------------------------------
# When 1/true, /info reads movie data from FIXTURES_DIR instead of IMDB_API_URL.
MOCK_MOVIE_DATA=0
# Directory holding JSON fixtures for the mock movie provider.
FIXTURES_DIR=./tests/fixtures/movie_search
# Runtime data directory (session file, cine.db). Defaults to ./data
DATA_DIR=./data
