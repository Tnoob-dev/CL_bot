 * Plyr, reconnect, local/online subs, audio tracks, gestures, lock, i18n (es default).
 * Icons are inlined in HTML (Reicon SVGs) — no icon package at runtime.
 */
(function () {
  "use strict";

  const STRINGS = {
    es: {
      brand: "CinemaLibrary",
      download: "Descargar",
      subtitles: "Subtítulos",
      audio: "Audio",
      streaming: "Streaming",
      volume: "Volumen",
